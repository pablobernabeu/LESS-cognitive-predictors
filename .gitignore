# Heavy derived datasets, reproducible from the scripts.
paper_2_plasticity/data_derived/

# Fitted brms/Stan objects are large and are regenerated by the model scripts.
paper_2_plasticity/results/*.rds

# Stan/cmdstanr scratch and compiled model artefacts.
*.stan
!**/stan/*.stan
*_cmdstan_*

# Quarto and LaTeX render artefacts. The manuscript PDF is deliberately NOT ignored:
# it is the published output of this repository.
/paper_2_plasticity/*_files/
/paper_2_plasticity/*.tex
/paper_2_plasticity/*.html
/paper_2_plasticity/*.rmarkdown
/paper_2_plasticity/*.log
/paper_2_plasticity/*.aux
/paper_2_plasticity/*.out
.quarto/

# Cluster job logs.
/paper_2_plasticity/hpc/logs/

# R session cruft.
.Rhistory
.Rdata
.Rproj.user/
